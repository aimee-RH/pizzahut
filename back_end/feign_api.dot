digraph "feign_api" {

splines  = ortho;
fontname = "Inconsolata";

node [colorscheme = ylgnbu4];
edge [colorscheme = dark28, dir = both];

AddressesMessage          [shape = record, label = "{ AddressesMessage | ~ addresses : String[]\l|# canEqual(Object) : boolean\l + setAddresses(String[]) : void\l + equals(Object) : boolean\l + getAddresses() : String[]\l + hashCode() : int\l + toString() : String\l|+ AddressesMessage(String[]) : \l + AddressesMessage() : \l }"];
BackupMessage             [shape = record, label = "{ BackupMessage | ~ backups : 备份记录[]\l|+ setBackups(备份记录[]) : void\l + getBackups() : 备份记录[]\l|+ BackupMessage(备份记录[]) : \l }"];
BuyDishesMessage          [shape = record, label = "{ BuyDishesMessage | ~ shops : 门店[]\l ~ canPrivilege : boolean\l ~ discount : float\l|+ setDiscount(float) : void\l + setShops(门店[]) : void\l + getShops() : 门店[]\l + setCanPrivilege(boolean) : void\l + isCanPrivilege() : boolean\l + getDiscount() : float\l|+ BuyDishesMessage(门店[], float, boolean) : \l }"];
Card                      [shape = record, label = "{ Card | ~ 编号 : String\l ~ 门店号 : String\l ~ 金额 : float\l ~ 种类 : String\l ~ 门店名 : String\l|+ get编号() : String\l + get金额() : float\l + get种类() : String\l + set金额(float) : void\l + get门店号() : String\l + set种类(String) : void\l + set门店名(String) : void\l + set编号(String) : void\l + get门店名() : String\l + set门店号(String) : void\l|+ Card() : \l }"];
CardMessage               [shape = record, label = "{ CardMessage | ~ cards : Card[]\l|+ getCards() : Card[]\l + setCards(Card[]) : void\l|+ CardMessage(Card[]) : \l }"];
CustomerCardMessage       [shape = record, label = "{ CustomerCardMessage | ~ cardID : String\l ~ CustomerID : String\l ~ shopID : String\l|+ getCustomerID() : String\l + setCustomerID(String) : void\l + getCardID() : String\l + setCardID(String) : void\l + getShopID() : String\l + setShopID(String) : void\l|+ CustomerCardMessage(String, String, String) : \l }"];
CustomerClients           [shape = record, label = "{ \<\<interface\>\>\nCustomerClients | + deleteOrder(String) : PostMessage\l + searchOrderDetail(String, String, String) : OrderDetailMessage\l + searchShopDishes(String) : ShopDishesMessage\l + searchDishes() : DishMessage\l }"];
CustomerMessage           [shape = record, label = "{ CustomerMessage | ~ level : String\l ~ name : String\l ~ sex : String\l ~ address : String[]\l ~ phone : String\l|+ getName() : String\l + setName(String) : void\l + setPhone(String) : void\l + setAddress(String[]) : void\l + setSex(String) : void\l + getPhone() : String\l + setLevel(String) : void\l + getAddress() : String[]\l + getSex() : String\l + getLevel() : String\l|+ CustomerMessage() : \l }"];
CustomersMessage          [shape = record, label = "{ CustomersMessage | ~ customers : 用户[]\l|+ getCustomers() : 用户[]\l + setCustomers(用户[]) : void\l|+ CustomersMessage(用户[]) : \l }"];
DealShopDishesMessage     [shape = record, label = "{ DealShopDishesMessage | ~ shopID : String\l ~ dishID : String\l|+ getShopID() : String\l + getDishID() : String\l + setDishID(String) : void\l + setShopID(String) : void\l|+ DealShopDishesMessage() : \l }"];
DefaultFeignConfiguration [shape = record, label = "{ DefaultFeignConfiguration | + logLevel() : Level\l|+ DefaultFeignConfiguration() : \l }"];
DeliversMessage           [shape = record, label = "{ DeliversMessage | ~ delivers : 配送员[]\l|+ getDelivers() : 配送员[]\l + setDelivers(配送员[]) : void\l|+ DeliversMessage(配送员[]) : \l }"];
DishMessage               [shape = record, label = "{ DishMessage | ~ dishes : 商品[]\l|+ setDishes(商品[]) : void\l # canEqual(Object) : boolean\l + equals(Object) : boolean\l + hashCode() : int\l + toString() : String\l + getDishes() : 商品[]\l|+ DishMessage(商品[]) : \l + DishMessage() : \l }"];
FeignApiApplication       [shape = record, label = "{ FeignApiApplication | + main(String[]) : void\l|+ FeignApiApplication() : \l }"];
InsertOrderMessage        [shape = record, label = "{ InsertOrderMessage | ~ orderList : 订单\l ~ paymentList : Payment[]\l|+ setPaymentList(Payment[]) : void\l + getOrderList() : 订单\l + setOrderList(订单) : void\l + getPaymentList() : Payment[]\l|+ InsertOrderMessage() : \l }"];
NavMessage                [shape = record, label = "{ NavMessage | ~ name : String\l ~ levelID : String\l ~ level : String\l ~ sex : String\l|+ setLevelID(String) : void\l + getLevelID() : String\l + setName(String) : void\l + setSex(String) : void\l + getName() : String\l + getLevel() : String\l + getSex() : String\l + setLevel(String) : void\l|+ NavMessage(String, String, String, String) : \l }"];
Order                     [shape = record, label = "{ Order | ~ 备注 : String\l ~ 配送员 : String\l ~ 特权 : String\l ~ 时间 : Date\l ~ 地址 : String\l ~ 总金额 : Float\l ~ 用券 : String\l ~ 用户 : String\l ~ 门店 : String\l ~ 用户名 : String\l ~ 配送员名 : String\l ~ 门店名 : String\l ~ 配送状态 : String\l ~ 编号 : String\l|+ set用户名(String) : void\l + set配送员名(String) : void\l + equals(Object) : boolean\l + set配送状态(String) : void\l + get门店() : String\l + get用户名() : String\l + get配送状态() : String\l + get配送员() : String\l + set用券(String) : void\l + get备注() : String\l + set门店(String) : void\l + get门店名() : String\l + get总金额() : Float\l + get编号() : String\l + set备注(String) : void\l + get特权() : String\l + toString() : String\l # canEqual(Object) : boolean\l + get用户() : String\l + get地址() : String\l + set配送员(String) : void\l + set地址(String) : void\l + set总金额(Float) : void\l + set用户(String) : void\l + get配送员名() : String\l + hashCode() : int\l + set特权(String) : void\l + get用券() : String\l + set编号(String) : void\l + set门店名(String) : void\l + get时间() : Date\l + set时间(Date) : void\l|+ Order() : \l }"];
OrderDetailMessage        [shape = record, label = "{ OrderDetailMessage | ~ deliver : 配送员\l ~ list : OrderDish[]\l ~ shop : 门店\l|+ getDeliver() : 配送员\l + getList() : OrderDish[]\l + setDeliver(配送员) : void\l + setList(OrderDish[]) : void\l + getShop() : 门店\l + setShop(门店) : void\l|+ OrderDetailMessage(OrderDish[], 配送员) : \l + OrderDetailMessage(OrderDish[], 门店, 配送员) : \l }"];
OrderDish                 [shape = record, label = "{ OrderDish | ~ 数量 : int\l ~ 金额 : float\l ~ 名称 : String\l|+ get名称() : String\l # canEqual(Object) : boolean\l + get数量() : int\l + set金额(float) : void\l + set名称(String) : void\l + equals(Object) : boolean\l + set数量(int) : void\l + hashCode() : int\l + toString() : String\l + get金额() : float\l|+ OrderDish() : \l }"];
OrderMessage              [shape = record, label = "{ OrderMessage | ~ orders : Order[]\l|+ getOrders() : Order[]\l + setOrders(Order[]) : void\l|+ OrderMessage(Order[]) : \l }"];
OrderStateMessage         [shape = record, label = "{ OrderStateMessage | ~ deliverID : String\l ~ orderID : String\l|+ getDeliverID() : String\l + setDeliverID(String) : void\l + getOrderID() : String\l + setOrderID(String) : void\l|+ OrderStateMessage() : \l }"];
Payment                   [shape = record, label = "{ Payment | ~ money : float\l ~ id : String\l ~ num : int\l|+ getId() : String\l + setNum(int) : void\l + setId(String) : void\l + setMoney(float) : void\l + getMoney() : float\l + getNum() : int\l|+ Payment() : \l }"];
PostMessage               [shape = record, label = "{ PostMessage | ~ code : Integer\l ~ msg : String\l|+ getCode() : Integer\l + setCode(Integer) : void\l + toString() : String\l + hashCode() : int\l # canEqual(Object) : boolean\l + setMsg(String) : void\l + equals(Object) : boolean\l + getMsg() : String\l|+ PostMessage(Integer, String) : \l + PostMessage() : \l }"];
ShopDishesMessage         [shape = record, label = "{ ShopDishesMessage | ~ availableDishes : String[]\l|# canEqual(Object) : boolean\l + getAvailableDishes() : String[]\l + hashCode() : int\l + equals(Object) : boolean\l + toString() : String\l + setAvailableDishes(String[]) : void\l|+ ShopDishesMessage() : \l + ShopDishesMessage(String[]) : \l }"];
SimpleMessage             [shape = record, label = "{ SimpleMessage | ~ data : String\l|+ setData(String) : void\l + getData() : String\l|+ SimpleMessage() : \l }"];
TemplateCardsMessage      [shape = record, label = "{ TemplateCardsMessage | ~ cards : 优惠券[]\l|+ getCards() : 优惠券[]\l + setCards(优惠券[]) : void\l|+ TemplateCardsMessage(优惠券[]) : \l }"];
UpdateAddressMessage      [shape = record, label = "{ UpdateAddressMessage | ~ id : String\l ~ addresses : String[]\l|+ setId(String) : void\l + setAddresses(String[]) : void\l + getAddresses() : String[]\l + getId() : String\l|+ UpdateAddressMessage() : \l }"];
UseCardMessage            [shape = record, label = "{ UseCardMessage | ~ secondDish : String\l ~ note : String\l ~ address : String\l ~ cardID : String\l ~ shop : String\l ~ CustomerID : String\l ~ firstDish : String\l|+ setAddress(String) : void\l + setCustomerID(String) : void\l + setCardID(String) : void\l + setNote(String) : void\l + getCardID() : String\l + getNote() : String\l + setFirstDish(String) : void\l + getCustomerID() : String\l + getSecondDish() : String\l + setSecondDish(String) : void\l + setShop(String) : void\l + getAddress() : String\l + getShop() : String\l + getFirstDish() : String\l|+ UseCardMessage() : \l }"];
优惠券                       [shape = record, label = "{ 优惠券 | ~ 编号 : String\l ~ 种类 : String\l ~ 金额 : float\l|+ set金额(float) : void\l + get金额() : float\l + get种类() : String\l + get编号() : String\l + set种类(String) : void\l + set编号(String) : void\l|+ 优惠券() : \l }"];
会员等级                      [shape = record, label = "{ 会员等级 | ~ 名称 : String\l ~ 折扣 : float\l ~ 编号 : String\l|+ set名称(String) : void\l + set折扣(float) : void\l + set编号(String) : void\l + get名称() : String\l + get编号() : String\l + get折扣() : float\l|+ 会员等级() : \l }"];
商品                        [shape = record, label = "{ 商品 | ~ 编号 : String\l ~ 名称 : String\l ~ 原价 : float\l ~ 种类 : String\l ~ 描述 : String\l|+ get编号() : String\l + set名称(String) : void\l + set原价(float) : void\l + get名称() : String\l + get原价() : float\l + set编号(String) : void\l + get描述() : String\l + set种类(String) : void\l + set描述(String) : void\l + get种类() : String\l|+ 商品() : \l }"];
备份记录                      [shape = record, label = "{ 备份记录 | ~ 编号 : String\l ~ 文件名 : String\l ~ 时间 : Date\l|+ get编号() : String\l + set文件名(String) : void\l + set时间(Date) : void\l + set编号(String) : void\l + get文件名() : String\l + get时间() : Date\l|+ 备份记录() : \l }"];
用户                        [shape = record, label = "{ 用户 | ~ 姓名 : String\l ~ 账号 : String\l ~ 会员等级 : String\l ~ 性别 : String\l ~ 密码 : String\l ~ 会员期限 : Data\l ~ 电话 : String\l|+ set会员期限(Data) : void\l + get账号() : String\l + get电话() : String\l + get会员等级() : String\l + get会员期限() : Data\l + set性别(String) : void\l + set姓名(String) : void\l + get性别() : String\l + get姓名() : String\l + set会员等级(String) : void\l + set电话(String) : void\l + get密码() : String\l + set账号(String) : void\l + set密码(String) : void\l|+ 用户() : \l }"];
管理员                       [shape = record, label = "{ 管理员 | ~ 账号 : String\l ~ 姓名 : String\l ~ 密码 : String\l|+ get姓名() : String\l + get账号() : String\l + get密码() : String\l + set账号(String) : void\l + set姓名(String) : void\l + set密码(String) : void\l|+ 管理员() : \l }"];
订单                        [shape = record, label = "{ 订单 | ~ 特权 : String\l ~ 备注 : String\l ~ 编号 : String\l ~ 时间 : Date\l ~ 用户 : String\l ~ 配送状态 : String\l ~ 配送员 : String\l ~ 用券 : String\l ~ 地址 : String\l ~ 门店 : String\l ~ 总金额 : Float\l|+ set地址(String) : void\l + set备注(String) : void\l + get总金额() : Float\l + set用券(String) : void\l + get特权() : String\l + set编号(String) : void\l + set配送员(String) : void\l + get用券() : String\l + get门店() : String\l + get备注() : String\l + set总金额(Float) : void\l + get编号() : String\l + toString() : String\l + get配送员() : String\l + set时间(Date) : void\l + get配送状态() : String\l + set门店(String) : void\l + set配送状态(String) : void\l + set特权(String) : void\l + get用户() : String\l + set用户(String) : void\l + get时间() : Date\l + get地址() : String\l|+ 订单(String, String, String, String, Float, String, String, String) : \l }"];
配送员                       [shape = record, label = "{ 配送员 | ~ 账号 : String\l ~ 密码 : String\l ~ 性别 : String\l ~ 姓名 : String\l ~ 电话 : String\l|+ set密码(String) : void\l + set性别(String) : void\l + get电话() : String\l + set账号(String) : void\l + set姓名(String) : void\l + set电话(String) : void\l + get密码() : String\l + get账号() : String\l + get姓名() : String\l + get性别() : String\l|+ 配送员() : \l }"];
门店                        [shape = record, label = "{ 门店 | ~ 密码 : String\l ~ 地址 : String\l ~ 名称 : String\l ~ 电话 : String\l ~ 下班时间 : Time\l ~ 账号 : String\l ~ 上班时间 : Time\l|+ get账号() : String\l + get名称() : String\l + get上班时间() : Time\l + set名称(String) : void\l + get密码() : String\l + set电话(String) : void\l + get地址() : String\l + get电话() : String\l + set账号(String) : void\l + set密码(String) : void\l + set下班时间(Time) : void\l + set地址(String) : void\l + set上班时间(Time) : void\l + get下班时间() : Time\l + toString() : String\l|+ 门店() : \l }"];


}
